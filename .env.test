# Must always set to production
# @see {@link https://www.youtube.com/watch?v=HMM7GJC5E2o}
NODE_ENV=production

# Server
FASTIFY_CLOSE_GRACE_DELAY=1000
LOG_LEVEL=info

# Security
RATE_LIMIT_MAX=4 # 4 is for tests, increase if you need more
POLLER_INTERVAL_MS=1000
ORACLE_SIGNATURE_THRESHOLD=2
RELAYER_FEE_SOLANA=1000
RELAYER_FEE_QUBIC=500
RELAYER_ENABLED=false
RELAYER_PROCESS_INTERVAL_MS=3000
RELAYER_MAX_ATTEMPTS=3
EVENT_MAX_RETRIES=2
EVENTS_LOOKBACK_DAYS=2
EVENTS_PROCESS_INTERVAL_MS=500

# Signer
SOLANA_KEYS=./test/fixtures/signer/solana.keys.json
QUBIC_KEYS=./test/fixtures/signer/qubic.keys.json

# Qubic
QUBIC_RPC_URL=http://127.0.0.1:3015

# Solana
SOLANA_RPC_URL=https://localhost:8901
SOLANA_WS_URL=ws://localhost:8901
SOLANA_TX_COMMITMENT=confirmed
SOLANA_TX_RETRY_MAX_ATTEMPTS=6
SOLANA_TX_RETRY_BASE_MS=500
SOLANA_TX_RETRY_MAX_MS=4000
SOLANA_MAX_PRIORITY_FEE=100000
SOLANA_LOOKUP_TABLE_ADDRESS=A8euVBJ83GE4MLcSgEG6eUL3eG7CdgMLcBXcB8XuDvU7
TOKEN_MINT=4bbjhGLSYwku6Y44dqwcroRfj2vHCdiHJ9SUmndc4FVg

# Hub
HUB_URLS=http://127.0.0.1:6101,http://127.0.0.1:6102
HUB_KEYS_FILE=./test/fixtures/hub-keys.json

# Database
SQLITE_DB_FILE=":memory:"
HOST=0.0.0.0
PORT=3000
